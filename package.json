{
  "name": "kevinmartinez-twd-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/post-build.mjs",
    "start": "npx serve build/client",
    "typecheck": "react-router typegen && tsc",
    "import:devto": "node scripts/import-devto.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test:ci": "twd-cli run",
    "dev:ci": "CI=true react-router dev",
    "collect:coverage:text": "npx nyc report --reporter=text --temp-dir .nyc_output",
    "collect:coverage:html": "npx nyc report --reporter=html --temp-dir .nyc_output",
    "collect:coverage:lcov": "npx nyc report --reporter=lcov --temp-dir .nyc_output",
    "lint:twd": "twd-lint"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "gray-matter": "^4.0.3",
    "isbot": "^5.2.2",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "twd-cli": "1.10.0",
    "twd-js": "1.12.0-beta.1",
    "twd-lint": "1.0.0",
    "twd-relay": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "overrides": {
    "twd-relay": {
      "twd-js": "1.12.0-beta.1"
    }
  }
}
